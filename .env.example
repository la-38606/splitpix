# Deploy-time configuration. Local development needs none of this:
# application.properties already points at the docker-compose database.
#
# The platform dashboard usually shows a postgres:// connection string.
# That is a libpq URL, not a JDBC URL - compose the JDBC form by hand.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DBNAME
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Injected by Render and similar platforms; picked up via server.port=${PORT:8080}.
PORT=8080

# Behind a TLS-terminating proxy, without this the app sees plain HTTP:
# invite cookies lose their Secure flag and copied invite links say http://.
SERVER_FORWARD_HEADERS_STRATEGY=framework
